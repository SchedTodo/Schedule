{
  "name": "schedule",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "A platform-independent schedule application",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test:unit": "vitest run tests/unit tests/contracts tests/parser",
    "test:e2e:web": "playwright test tests/e2e/web",
    "parser:generate": "java -jar tools/antlr/antlr-4.13.2-complete.jar -Dlanguage=TypeScript -visitor -no-listener -Xexact-output-dir -o src/parser/generated src/parser/grammar/Schedule.g4 && node tools/antlr/postprocess-generated.mjs",
    "parser:check-generated": "pnpm parser:generate && git diff --exit-code -- src/parser/generated",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build:web"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@vueuse/core": "latest",
    "antlr4": "4.13.2",
    "naive-ui": "latest",
    "pinia": "latest",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "@vue/test-utils": "latest",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "fast-check": "^4.9.0",
    "jsdom": "latest",
    "prettier": "^3.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "vite": "^8.0.0",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
}
